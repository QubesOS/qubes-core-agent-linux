"""Run qfile-unpacker, asking the user what to do with files that already
exist in QubesIncoming.

usage: qfile-conflict-dialog QFILE_UNPACKER [ARGS...]

This runs in the user's session (not in qfile-unpacker's sandbox), and talks
to qfile-unpacker over a socket passed with --conflict-fd.
"""

import os
import signal
import socket
import subprocess
import sys
import unicodedata

OVERWRITE = b"o"
SKIP = b"s"
RENAME = b"r"
ABORT = b"a"


def printable(name):
    """Escape characters that could fake text or reorder it in the dialog."""
    return "".join(
        c if c.isprintable() and unicodedata.category(c) != "Cf"
        else f"\\x{ord(c):02x}" if ord(c) < 0x100 else f"\\u{ord(c):04x}"
        for c in name)


def ask(source, name, can_overwrite, suggestion, error):
    """Show the dialog. Returns (answer, new name, apply to all)."""
    # pylint: disable=import-outside-toplevel
    import gi

    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk, Pango

    dialog = Gtk.Dialog(title="File already exists")
    dialog.set_keep_above(True)
    dialog.set_position(Gtk.WindowPosition.CENTER)
    dialog.add_button("Stop copying", Gtk.ResponseType.CANCEL)
    dialog.add_button("Continue", Gtk.ResponseType.OK)
    dialog.set_default_response(Gtk.ResponseType.OK)

    box = dialog.get_content_area()
    box.set_spacing(8)
    box.set_border_width(12)

    def add_label(text, **kwargs):
        label = Gtk.Label(label=text, xalign=0, wrap=True,
                          wrap_mode=Pango.WrapMode.WORD_CHAR,
                          max_width_chars=60, **kwargs)
        box.pack_start(label, False, False, 0)
        return label

    source_markup = GLib.markup_escape_text(source)
    add_label("").set_markup(
        f"Qube <b>{source_markup}</b> sent a file, but a file with this name "
        f"already exists in QubesIncoming/{source_markup}:")
    add_label(printable(name), selectable=True).get_style_context().add_class(
        "monospace")
    if error:
        add_label(error)

    # skip first, so that it is the default
    skip = Gtk.RadioButton.new_with_label(None, "Skip this file")
    replace = Gtk.RadioButton.new_with_label_from_widget(
        skip, "Replace the existing file")
    replace.set_sensitive(can_overwrite)
    rename = Gtk.RadioButton.new_with_label_from_widget(skip, "Save as:")
    entry = Gtk.Entry(text=suggestion, hexpand=True, activates_default=True)
    rename_box = Gtk.Box(spacing=6)
    rename_box.pack_start(rename, False, False, 0)
    rename_box.pack_start(entry, True, True, 0)
    for widget in (skip, replace, rename_box):
        box.pack_start(widget, False, False, 0)

    apply_all = Gtk.CheckButton(
        label="Do the same for the remaining conflicts")
    box.pack_start(apply_all, False, False, 0)

    def update(*_args):
        apply_all.set_sensitive(not rename.get_active())

    entry.connect("changed", lambda *_: rename.set_active(True))
    entry.connect("button-press-event", lambda *_: rename.set_active(True))
    rename.connect("toggled", update)
    update()

    dialog.show_all()
    response = dialog.run()
    if rename.get_active():
        answer, new_name = RENAME, entry.get_text()
    else:
        answer, new_name = (OVERWRITE if replace.get_active() else SKIP), ""
    all_conflicts = apply_all.get_active() and answer != RENAME
    dialog.destroy()
    while Gtk.events_pending():
        Gtk.main_iteration()
    if response != Gtk.ResponseType.OK:
        return ABORT, "", False
    return answer, new_name, all_conflicts


def serve(sock, source):
    """Answer qfile-unpacker's requests until it closes the socket."""
    remembered = None
    while True:
        request = sock.recv(65536)
        if not request:
            return
        try:
            can_overwrite, name, suggestion, error = (
                field.decode("utf-8", "replace")
                for field in request.split(b"\0")[:4])
        except ValueError:
            return
        can_overwrite = can_overwrite == "1"
        if remembered and not error and (remembered == SKIP or can_overwrite):
            reply = remembered
        else:
            try:
                answer, new_name, all_conflicts = ask(
                    source, name, can_overwrite, suggestion, error)
            except Exception:  # pylint: disable=broad-except
                # no GUI: stop the copy, as without this dialog
                answer, new_name, all_conflicts = ABORT, "", False
            if all_conflicts:
                remembered = answer
            reply = answer
            if answer == RENAME:
                reply += b"\0" + new_name.encode()
        sock.send(reply)


def main():
    """Run qfile-unpacker and answer its questions."""
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 1
    ours, theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    unpacker = subprocess.Popen(  # pylint: disable=consider-using-with
        [sys.argv[1], f"--conflict-fd={theirs.fileno()}"] + sys.argv[2:],
        pass_fds=(theirs.fileno(),))
    theirs.close()
    # don't hold the qrexec streams; keep GTK messages from the sender
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    os.close(null)
    if "DISPLAY" not in os.environ:
        os.environ["DISPLAY"] = ":0"
    try:
        serve(ours, os.environ.get("QREXEC_REMOTE_DOMAIN", ""))
    finally:
        ours.close()
        ret = unpacker.wait()
    if ret < 0:
        return 128 + signal.Signals(-ret)
    return ret


if __name__ == "__main__":
    sys.exit(main())
