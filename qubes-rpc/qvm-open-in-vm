# lack of -e and -u is intentional

# we use “is this variable set” a lot, and use variables that we haven’t set, so
# unset these variables first, to ensure that values from the environment don’t
# cause problems.
unset qopen_opts target filename seen_dashdash i nargs service status error

usage() {
    case $0 in
    (qvm-open-in-dvm|*/qvm-open-in-dvm)
        printf 'Usage: %s [--view-only] [--] filename\n' "$0"
        printf '       %s [--] file|directory...\n' "$0"
        ;;
    (*) printf 'Usage: %s [--view-only] [--] [vmname] filename\n' "$0"
        printf '       %s [--] vmname file|directory...\n' "$0"
        ;;
    esac >&2
    exit "${1-2}"
}
case $0 in
(qvm-open-in-dvm|*/qvm-open-in-dvm) target=@dispvm;;
(qvm-open-in-vm|*/qvm-open-in-vm) :;;
(*) printf 'Must be invoked as qvm-open-in-vm or qvm-open-in-dvm, not as %s\n' "$0" >&2
    exit 2;;
esac

# move the non-option arguments to "$@"
nargs=$#
for i; do
    if [ -z "$seen_dashdash" ]; then
        case $i in
        (--) seen_dashdash=x; continue;;
        (--help) usage 0;;
        (--view-only) qopen_opts=--view-only; continue;;
        (-*) usage;;
        esac
    fi
    set -- "$@" "$i"
done
shift "$nargs"

case $0 in
(qvm-open-in-dvm|*/qvm-open-in-dvm) ;;
(*)
    if [ "$#" -ge 2 ]; then
        target=$1
        shift
    else
        target=@default
    fi
    ;;
esac

if [ -z "$target" ] || [ "$#" -eq 0 ]; then
    usage
fi

if [ "$#" -eq 1 ] && [ ! -d "$1" ]; then
    filename=$1
    if [ ! -f "$filename" ]; then
        expr "@$filename" : '@[A-Za-z][A-Za-z0-9+]*://'>/dev/null
        # shellcheck disable=SC2181
        if [ $? -ne 0 ]; then
            printf 'Error! "%s" is not a valid file or URL.\n' "$filename"
            usage
        fi
    fi
else
    # several files or a directory: copy them, they are opened read-only and
    # changes are not sent back
    nargs=$#
    for i; do
        if [ ! -e "$i" ]; then
            printf 'Error! "%s" is not a valid file or directory.\n' "$i"
            usage
        fi
        # like qvm-copy, "dir/" would be sent with an empty name
        while [ "$i" != / ] && [ "${i%/}" != "$i" ]; do
            i=${i%/}
        done
        set -- "$@" "$i"
    done
    shift "$nargs"
    service=qubes.OpenFilesInVM
    error=$(/usr/lib/qubes/qubes-fs-tree-check --allow-symlinks \
        --allow-directories --machine -- "$@" 2>&1 >/dev/null)
    status=$?
    case $status in
    (0) ;;
    (2) service=qubes.OpenFilesInVM+allow-all-names;;
    (*)
        printf '%s\n' "$error" >&2
        # started from a file manager, nobody sees stderr
        if [ ! -t 2 ]; then
            if command -v notify-send >/dev/null; then
                notify-send -- "Cannot open in qube" "$error"
            elif command -v zenity >/dev/null; then
                zenity --notification --text "Cannot open in qube: $error"
            fi
        fi
        exit "$status";;
    esac
fi

prompt_text='Are you sure you want to create another disposable VM?'
case $target in
(@dispvm|@dispvm:*)
    case ${QREXEC_SERVICE_FULL_NAME-} in
    (qubes.OpenInVM+*|qubes.OpenURL+*|qubes.OpenFilesInVM+*)
        if [ -f /usr/bin/zenity ]; then
            zenity --question "--text=$prompt_text" || exit "$?"
        elif [ -f /usr/bin/kdialog ]; then
            kdialog "--yesno=$prompt_text" || exit "$?"
        else
            printf 'Cannot prompt user, exiting to avoid possible infinite VM creation loop.\n' >&2
            exit 1
        fi
        ;;
    esac
    ;;
esac

if [ -n "$service" ]; then
    # keep the connection open until the remote side is done with the files
    # shellcheck disable=SC2016
    exec /usr/lib/qubes/qrexec-client-vm -- "$target" "$service" \
        /bin/sh -c '"$0" -- "$@" && exec cat >/dev/null' \
        /usr/lib/qubes/qfile-agent "$@" >/dev/null 2>&1 </dev/null
fi

expr "@$filename" : '@[A-Za-z][A-Za-z0-9+]*://'>/dev/null
# shellcheck disable=SC2016
case $? in
(0) exec /usr/lib/qubes/qrexec-client-vm -- "$target" qubes.OpenURL \
    /bin/sh -c 'printf %s\\n "$1"; exec cat >/dev/null' sh "$filename";;
(1) exec /usr/lib/qubes/qrexec-client-vm -- "$target" qubes.OpenInVM \
    /usr/lib/qubes/qopen-in-vm $qopen_opts -- "$filename";;
(*) exit "$?";;
esac >/dev/null 2>&1 </dev/null
