#!/bin/sh

set -e

ROOTDEV=/dev/mapper/dmroot
DEV=$(readlink -e "$ROOTDEV")
DEV=${DEV%%[0-9]}

# If underlying root device is read-only, don't do anything
if [ "$(blockdev --getro "$DEV")" -eq "1" ]; then
    echo "$DEV is read-only, not resizing" >&2
    exit 0
fi

verify_partitions_synced() {
    # TODO: cache sfdisk output
    sfdisk -l "$1" |
      grep "^$1" |
      # shellcheck disable=SC2030
      while read -r DEV _ _ SZ _; do
        [ "$SZ" -eq "$(blockdev --getsz "$DEV")" ] || return 1
      done
}

dm_major=$(printf %x "$(grep device-mapper /proc/devices | cut -f 1 -d ' ')")
case "$(stat -Lc %t:%T "$ROOTDEV")" in
    ca:0)
        # nothing needed, xvda used directly
        ;;
    ca:3)
        # Check to see if the size of all the partitions added together is around
        # the same size as the parent block device
        last_part_sec=$(sfdisk -l "$DEV" | tail -n1 | (read -r _ _ E _ _; echo "$E"))
        gpt_hdr_sz=34
        # If the disk size is greater than the last partition sector + GPT
        # header size, then there is emplty space after the last partition
        # and the partitios should be resized.
        if [ "$(blockdev --getsz "$DEV")" -gt $((last_part_sec + gpt_hdr_sz)) ]; then
            echo "Partitions need resizing" >&2

            # Resize partition table itself and xda3 partition
            echo ',+' | sfdisk --no-reread --no-tell-kernel -q -N 3 "$DEV"
            # and reload partition table; prefer partprobe over blockdev
            # --rereadpt, as it works on mounted partitions
            partprobe "$DEV"
            udevadm settle
            while ! verify_partitions_synced "$DEV"; do
                sleep 1
            done
            # Use block device directly to avoid potential dangling symlinks
            ROOTDEV="$DEV"3
        fi
        ;;
    ca:*)
        echo "Unsupported partition layout, resize it manually" >&2
        exit 1
        ;;
    $dm_major:*)
        new_size=$(cat /sys/block/xvda/size)
        ro=$(cat /sys/block/xvda/ro)
        if [ "$ro" -eq 1 ]; then
            new_table="0 $new_size snapshot /dev/xvda /dev/xvdc2 N 16"
        else
            new_table="0 $new_size linear /dev/xvda 0"
        fi
        dmsetup load dmroot --table "$new_table"
        dmsetup resume dmroot
        ;;
    *)
        echo "Unsupported device type for root volume, resize it manually" >&2
        exit 1
        ;;
esac
resize2fs /dev/mapper/dmroot
